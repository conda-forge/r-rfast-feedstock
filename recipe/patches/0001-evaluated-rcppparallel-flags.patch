From: Mervin Fansler <mervin.fansler@bric.ku.dk>
Date: Tue, 7 Oct 2025 10:49:07 +0200
Subject: [PATCH] evaluated rcppparallel flags

---
 src/Makevars | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/src/Makevars b/src/Makevars
index d8c1549..ed4ed0e 100644
--- a/src/Makevars
+++ b/src/Makevars
@@ -1,4 +1,4 @@
-PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS) `"${R_HOME}/bin/Rscript" -e "RcppParallel::LdFlags()"`
+PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS) $(SHLIB_OPENMP_CXXFLAGS) -ltbb -ltbbmalloc
 
 PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
 
